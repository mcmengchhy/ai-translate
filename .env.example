DEFAULT_ENGINE=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
HOST=0.0.0.0
PORT=8000
# Process one video at a time to reduce overlap between memory-heavy stages.
VIDEO_MAX_CONCURRENT_JOBS=1
# Shared voice downloads across all jobs; audio settings are unaffected.
TTS_MAX_CONCURRENT_REQUESTS=4
TTS_REQUEST_INTERVAL=0.2
