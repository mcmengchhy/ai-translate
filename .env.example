# Khmer AI Translator Configuration

# Optional: Google Gemini API Key (for high-nuance, tone-aware translation)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Default Gemini model: gemini-2.0-flash or gemini-1.5-flash
DEFAULT_GEMINI_MODEL=gemini-2.0-flash

# Optional: OpenAI or Ollama configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Server Port and Host
PORT=8000
HOST=0.0.0.0
